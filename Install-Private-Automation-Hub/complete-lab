Subtask 2.4: Initialize the Database
# Create logs directory
mkdir -p /opt/automationhub/logs

# Set Django settings module
export DJANGO_SETTINGS_MODULE=settings
export PYTHONPATH=/opt/automationhub/config:$PYTHONPATH

# Navigate to config directory
cd /opt/automationhub/config

# Run database migrations
python -m django migrate --settings=settings

# Create static files directory
mkdir -p /opt/automationhub/static

# Collect static files
python -m django collectstatic --noinput --settings=settings

# Create superuser account
python -m django createsuperuser --settings=settings
When prompted, create an admin user:

Username: admin
Email: admin@example.com
Password: admin123 (use a strong password in production)
Task 3: Configure Web Server and Services
Subtask 3.1: Create Systemd Service Files
Exit from the automationhub user and return to your regular user with sudo access:

exit  # Exit from automationhub user
Create systemd service files for Galaxy NG:

# Create the main Galaxy NG service
sudo tee /etc/systemd/system/galaxy-ng.service << 'EOF'
[Unit]
Description=Galaxy NG API Server
After=network.target postgresql.service redis.service

[Service]
Type=notify
User=automationhub
Group=automationhub
WorkingDirectory=/opt/automationhub/config
Environment=DJANGO_SETTINGS_MODULE=settings
Environment=PYTHONPATH=/opt/automationhub/config
ExecStart=/opt/automationhub/venv/bin/gunicorn galaxy_ng.app.wsgi:application \
    --bind 127.0.0.1:8080 \
    --workers 4 \
    --timeout 120 \
    --max-requests 1000 \
    --max-requests-jitter 100
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

# Create worker service for background tasks
sudo tee /etc/systemd/system/galaxy-ng-worker.service << 'EOF'
[Unit]
Description=Galaxy NG Worker
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=automationhub
Group=automationhub
WorkingDirectory=/opt/automationhub/config
Environment=DJANGO_SETTINGS_MODULE=settings
Environment=PYTHONPATH=/opt/automationhub/config
ExecStart=/opt/automationhub/venv/bin/python -m django rq worker --settings=settings
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
Subtask 3.2: Configure Nginx Reverse Proxy
# Create Nginx configuration for Galaxy NG
sudo tee /etc/nginx/conf.d/galaxy-ng.conf << 'EOF'
server {
    listen 80;
    server_name localhost;
    client_max_body_size 100M;

    location /static/ {
        alias /opt/automationhub/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /opt/automationhub/media/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
EOF

# Test Nginx configuration
sudo nginx -t

# Remove default Nginx site
sudo rm -f /etc/nginx/conf.d/default.conf
Subtask 3.3: Configure Firewall
# Open HTTP port
sudo firewall-cmd --permanent --add-service=http
sudo firewall-cmd --permanent --add-port=8080/tcp
sudo firewall-cmd --reload

# Verify firewall rules

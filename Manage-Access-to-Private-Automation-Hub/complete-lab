Create a log monitoring script:
# Create a monitoring script
sudo vi /usr/local/bin/galaxy-audit-monitor.sh

#!/bin/bash
# Galaxy Audit Log Monitor

LOG_FILE="/var/log/galaxy/audit.log"
REPORT_FILE="/tmp/galaxy-audit-report-$(date +%Y%m%d).txt"

echo "Galaxy Automation Hub Audit Report - $(date)" > $REPORT_FILE
echo "================================================" >> $REPORT_FILE
echo "" >> $REPORT_FILE

echo "User Login Summary:" >> $REPORT_FILE
grep "login" $LOG_FILE | awk '{print $4}' | sort | uniq -c >> $REPORT_FILE
echo "" >> $REPORT_FILE

echo "Failed Access Attempts:" >> $REPORT_FILE
grep -i "denied\|failed\|unauthorized" $LOG_FILE >> $REPORT_FILE
echo "" >> $REPORT_FILE

echo "Collection Activities:" >> $REPORT_FILE
grep -i "collection" $LOG_FILE | tail -20 >> $REPORT_FILE

echo "Report generated: $REPORT_FILE"
Make the script executable and run it:
sudo chmod +x /usr/local/bin/galaxy-audit-monitor.sh
sudo /usr/local/bin/galaxy-audit-monitor.sh
Subtask 3.5: Set Up Automated Log Rotation
Configure log rotation for audit logs:
# Create logrotate configuration
sudo vi /etc/logrotate.d/galaxy-audit

/var/log/galaxy/audit.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 644 pulp pulp
    postrotate
        systemctl reload pulpcore-api
    endscript
}
Test the log rotation configuration:
sudo logrotate -d /etc/logrotate.d/galaxy-audit
Subtask 3.6: Create Access Monitoring Dashboard
Create a simple monitoring script that generates regular reports:
# Create monitoring cron job
sudo vi /usr/local/bin/daily-access-report.sh

#!/bin/bash
# Daily Galaxy Access Report

DATE=$(date +%Y-%m-%d)
REPORT_DIR="/var/log/galaxy/reports"
REPORT_FILE="$REPORT_DIR/access-report-$DATE.txt"

mkdir -p $REPORT_DIR

echo "Galaxy Private Automation Hub - Daily Access Report" > $REPORT_FILE
echo "Date: $DATE" >> $REPORT_FILE
echo "=================================================" >> $REPORT_FILE

# Count unique users
echo "Unique Users Active Today:" >> $REPORT_FILE
grep "$(date +%Y-%m-%d)" /var/log/galaxy/audit.log | grep -o 'user:[^[:space:]]*' | sort | uniq | wc -l >> $REPORT_FILE

# List active users
echo "" >> $REPORT_FILE
echo "Active Users:" >> $REPORT_FILE
grep "$(date +%Y-%m-%d)" /var/log/galaxy/audit.log | grep -o 'user:[^[:space:]]*' | sort | uniq >> $REPORT_FILE

# Count activities by type
echo "" >> $REPORT_FILE
echo "Activity Summary:" >> $REPORT_FILE
grep "$(date +%Y-%m-%d)" /var/log/galaxy/audit.log | awk '{print $6}' | sort | uniq -c >> $REPORT_FILE

# Security events
echo "" >> $REPORT_FILE
echo "Security Events:" >> $REPORT_FILE
grep "$(date +%Y-%m-%d)" /var/log/galaxy/audit.log | grep -i "denied\|failed\|error" >> $REPORT_FILE

echo "Report generated at: $(date)" >> $REPORT_FILE
Make the script executable:
sudo chmod +x /usr/local/bin/daily-access-report.sh
Add to crontab for daily execution:
# Add cron job for daily reports
sudo crontab -e

# Add this line to run daily at 11:59 PM
59 23 * * * /usr/local/bin/daily-access-report.sh

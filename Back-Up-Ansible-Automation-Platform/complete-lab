Subtask 1.2: Back Up the Controller Database
The Automation Controller uses PostgreSQL to store all configuration data, job history, and user information.

Step 1: Create Database Backup Script

# Create backup script
cat > /backup/controller/backup_controller_db.sh << 'EOF'
#!/bin/bash

# Set variables
BACKUP_DIR="/backup/controller/database"
DATE=$(date +%Y%m%d_%H%M%S)
DB_NAME="awx"
DB_USER="awx"
DB_HOST="localhost"

# Create timestamped backup
echo "Starting database backup at $(date)"

# Perform database dump
sudo -u awx pg_dump -h $DB_HOST -U $DB_USER -d $DB_NAME \
  --verbose --clean --create --if-exists \
  --file="$BACKUP_DIR/controller_db_$DATE.sql"

# Compress the backup
gzip "$BACKUP_DIR/controller_db_$DATE.sql"

# Verify backup file
if [ -f "$BACKUP_DIR/controller_db_$DATE.sql.gz" ]; then
    echo "Database backup completed successfully: controller_db_$DATE.sql.gz"
    ls -lh "$BACKUP_DIR/controller_db_$DATE.sql.gz"
else
    echo "Database backup failed!"
    exit 1
fi

# Keep only last 7 days of backups
find $BACKUP_DIR -name "controller_db_*.sql.gz" -mtime +7 -delete

echo "Database backup process completed at $(date)"
EOF

# Make script executable
chmod +x /backup/controller/backup_controller_db.sh
Step 2: Execute Database Backup

# Run the database backup
/backup/controller/backup_controller_db.sh

# Verify backup was created
ls -la /backup/controller/database/

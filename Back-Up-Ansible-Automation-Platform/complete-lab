Task 3: Verify the Integrity of Backups and Restore
Subtask 3.1: Create Backup Verification Scripts
Step 1: Create Controller Backup Verification Script

# Create controller verification script
cat > /backup/verify_controller_backup.sh << 'EOF'
#!/bin/bash

echo "=== Controller Backup Verification ==="
echo "Date: $(date)"
echo

BACKUP_BASE="/backup/controller"

# Check database backups
echo "Database Backups:"
DB_BACKUPS=$(find $BACKUP_BASE/database -name "*.sql.gz" -mtime -1)
if [ -n "$DB_BACKUPS" ]; then
    for backup in $DB_BACKUPS; do
        echo "  ✓ $backup"
        echo "    Size: $(ls -lh $backup | awk '{print $5}')"
        echo "    Date: $(ls -l $backup | awk '{print $6, $7, $8}')"
        
        # Test gunzip without extracting
        if gunzip -t "$backup" 2>/dev/null; then
            echo "    Status: ✓ Valid compressed file"
        else
            echo "    Status: ✗ Corrupted file"
        fi
        echo
    done
else
    echo "  ✗ No recent database backups found"
fi

# Check configuration backups
echo "Configuration Backups:"
CONFIG_BACKUPS=$(find $BACKUP_BASE/config -name "*.tar.gz" -mtime -1)
if [ -n "$CONFIG_BACKUPS" ]; then
    for backup in $CONFIG_BACKUPS; do
        echo "  ✓ $backup"
        echo "    Size: $(ls -lh $backup | awk '{print $5}')"
        echo "    Date: $(ls -l $backup | awk '{print $6, $7, $8}')"
        
        # Test tar file integrity
        if tar -tzf "$backup" >/dev/null 2>&1; then
            echo "    Status: ✓ Valid tar archive"
            echo "    Files: $(tar -tzf $backup | wc -l) files"
        else
            echo "    Status: ✗ Corrupted archive"
        fi
        echo
    done
else
    echo "  ✗ No recent configuration backups found"
fi

echo "=== Verification Complete ==="
EOF

# Make script executable
chmod +x /backup/verify_controller_backup.sh

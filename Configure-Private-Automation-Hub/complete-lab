Task 3: Monitor Uploaded Content for Updates
Subtask 3.1: Set Up Content Monitoring
Create a monitoring script:
cat > ~/monitor_collections.py << 'EOF'
#!/usr/bin/env python3
import requests
import json
import time
import urllib3
from datetime import datetime

# Disable SSL warnings for self-signed certificates
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

class HubMonitor:
    def __init__(self, base_url, username, password):
        self.base_url = base_url
        self.session = requests.Session()
        self.session.verify = False
        self.token = self.get_token(username, password)
        self.session.headers.update({'Authorization': f'Token {self.token}'})
    
    def get_token(self, username, password):
        """Get authentication token"""
        auth_url = f"{self.base_url}/api/galaxy/v3/auth/token/"
        response = self.session.post(auth_url, json={
            'username': username,
            'password': password
        })
        return response.json()['token']
    
    def get_collections(self):
        """Get list of all collections"""
        collections_url = f"{self.base_url}/api/galaxy/v3/collections/"
        response = self.session.get(collections_url)
        return response.json()
    
    def get_collection_versions(self, namespace, name):
        """Get versions for a specific collection"""
        versions_url = f"{self.base_url}/api/galaxy/v3/collections/{namespace}/{name}/versions/"
        response = self.session.get(versions_url)
        return response.json()
    
    def monitor_collections(self, interval=60):
        """Monitor collections for changes"""
        print(f"Starting collection monitoring (checking every {interval} seconds)")
        previous_state = {}
        
        while True:
            try:
                current_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                print(f"\n[{current_time}] Checking for updates...")
                
                collections = self.get_collections()
                current_state = {}
                
                for collection in collections.get('data', []):
                    namespace = collection['namespace']['name']
                    name = collection['name']
                    key = f"{namespace}.{name}"
                    
                    versions = self.get_collection_versions(namespace, name)
                    version_list = [v['version'] for v in versions.get('data', [])]
                    current_state[key] = {
                        'versions': version_list,
                        'latest_version': max(version_list) if version_list else None,
                        'total_versions': len(version_list)
                    }
                
                # Compare with previous state
                if previous_state:
                    for key, current_info in current_state.items():
                        if key in previous_state:
                            prev_info = previous_state[key]
                            if current_info['total_versions'] > prev_info['total_versions']:
                                print(f"🔄 UPDATE DETECTED: {key}")
                                print(f"   New versions: {set(current_info['versions']) - set(prev_info['versions'])}")
                                print(f"   Latest version: {current_info['latest_version']}")
                        else:
                            print(f"🆕 NEW COLLECTION: {key}")
                            print(f"   Latest version: {current_info['latest_version']}")
                
                # Display current status
                print(f"📊 Current Status:")
                for key, info in current_state.items():
                    print(f"   {key}: {info['total_versions']} versions, latest: {info['latest_version']}")
                
                previous_state = current_state.copy()
                time.sleep(interval)
                
            except KeyboardInterrupt:
                print("\nMonitoring stopped by user")
                break
            except Exception as e:
                print(f"Error during monitoring: {e}")
                time.sleep(interval)

if __name__ == "__main__":
    monitor = HubMonitor(
        base_url="https://localhost",
        username="content_manager",
        password="ContentMgr123!"
    )
    monitor.monitor_collections(interval=30)
EOF

Subtask 3.2: Create Collection Update Detection
Create a simple update detection script:
cat > ~/check_updates.sh << 'EOF'
#!/bin/bash

HUB_URL="https://localhost"
USERNAME="content_manager"
PASSWORD="ContentMgr123!"

# Function to get authentication token
get_token() {
    curl -k -s -X POST "${HUB_URL}/api/galaxy/v3/auth/token/" \
        -H "Content-Type: application/json" \
        -d "{\"username\": \"${USERNAME}\", \"password\": \"${PASSWORD}\"}" | \
        python3 -c "import sys, json; print(json.load(sys.stdin)['token'])"
}

# Function to get collections
get_collections() {
    local token=$1
    curl -k -s -H "Authorization: Token ${token}" \
        "${HUB_URL}/api/galaxy/v3/collections/" | \
        python3 -c "
import sys, json
data = json.load(sys.stdin)
for collection in data.get('data', []):
    namespace = collection['namespace']['name']
    name = collection['name']
    print(f'{namespace}.{name}')
"
}

# Function to get collection versions
get_collection_versions() {
    local token=$1
    local namespace=$2
    local name=$3
    curl -k -s -H "Authorization: Token ${token}" \
        "${HUB_URL}/api/galaxy/v3/collections/${namespace}/${name}/versions/" | \
        python3 -c "
import sys, json
data = json.load(sys.stdin)
versions = [v['version'] for v in data.get('data', [])]
print(' '.join(versions))
"
}

# Main monitoring function
monitor_updates() {
    echo "Getting authentication token..."
    TOKEN=$(get_token)
    
    if [ -z "$TOKEN" ]; then
        echo "Failed to get authentication token"
        exit 1
    fi
    
    echo "Fetching collections..."
    COLLECTIONS=$(get_collections "$TOKEN")
    
    echo "Current collections and versions:"
    echo "================================="
    
    while IFS= read -r collection; do
        if [ -n "$collection" ]; then
            namespace=$(echo "$collection" | cut -d'.' -f1)
            name=$(echo "$collection" | cut -d'.' -f2)
            versions=$(get_collection_versions "$TOKEN" "$namespace" "$name")
            echo "📦 $collection"
            echo "   Versions: $versions"
            echo "   Total versions: $(echo $versions | wc -w)"
            echo ""
        fi
    done <<< "$COLLECTIONS"
}

# Run the monitoring
monitor_updates
EOF

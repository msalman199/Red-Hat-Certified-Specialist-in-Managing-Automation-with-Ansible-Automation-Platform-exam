Create a content manager role using the command line:

sudo pulpcore-manager shell << 'EOF'
from django.contrib.auth.models import Group, Permission
from django.contrib.contenttypes.models import ContentType

# Create Content Manager group
content_manager_group, created = Group.objects.get_or_create(name='Content Managers')

# Add permissions for content management
permissions = [
    'add_collection',
    'change_collection',
    'delete_collection',
    'view_collection',
    'add_collectionversion',
    'change_collectionversion',
    'view_collectionversion'
]

for perm_name in permissions:
    try:
        permission = Permission.objects.get(codename=perm_name)
        content_manager_group.permissions.add(permission)
    except Permission.DoesNotExist:
        print(f"Permission {perm_name} not found")

content_manager_group.save()
print("Content Manager group created successfully")
EOF

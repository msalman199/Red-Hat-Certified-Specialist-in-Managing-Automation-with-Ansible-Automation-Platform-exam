Subtask 3.3: Create Test Playbook
Create a custom playbook for testing
On the control node, create a test repository:

mkdir -p ~/test-playbooks
cd ~/test-playbooks

# Initialize git repository
git init
git config user.name "Lab Student"
git config user.email "student@example.com"
Create a test playbook
cat > mesh-test-playbook.yml << EOF
---
- name: Mesh Functionality Test
  hosts: all
  gather_facts: yes
  tasks:
    - name: Display execution node information
      debug:
        msg: |
          Executing on: {{ inventory_hostname }}
          Ansible node: {{ ansible_hostname }}
          Region: {{ region | default('unknown') }}
          Date/Time: {{ ansible_date_time.iso8601 }}

    - name: Create test file with node info
      copy:
        content: |
          Execution Node: {{ ansible_hostname }}
          Target Host: {{ inventory_hostname }}
          Region: {{ region | default('unknown') }}
          Execution Time: {{ ansible_date_time.iso8601 }}
        dest: /tmp/mesh-test-{{ inventory_hostname }}.txt
      become: yes

    - name: Verify file creation
      stat:
        path: /tmp/mesh-test-{{ inventory_hostname }}.txt
      register: test_file

    - name: Display file status
      debug:
        msg: "Test file created successfully: {{ test_file.stat.exists }}"

    - name: Run region-specific task
      debug:
        msg: "This task is running in {{ region | default('unknown region') }}"
      when: region is defined

    - name: Simulate work load
      command: sleep 5
      changed_when: false

    - name: Final status
      debug:
        msg: "Mesh test completed successfully on {{ inventory_hostname }}"
EOF
Create inventory file
cat > inventory.yml << EOF
all:
  children:
    region_a:
      hosts:
        target-host-1:
          ansible_host: target-host-1
          region: region-a
    region_b:

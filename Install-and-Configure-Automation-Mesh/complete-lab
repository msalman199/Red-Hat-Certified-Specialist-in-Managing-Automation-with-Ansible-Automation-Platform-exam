Subtask 1.2: Install AWX (Open Source Automation Platform)
AWX is the open-source upstream project for Red Hat Ansible Automation Platform.

Clone the AWX Operator repository
cd /opt
sudo git clone https://github.com/ansible/awx-operator.git
cd awx-operator
Install kubectl and kind for Kubernetes deployment
# Install kubectl
curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl

# Install kind (Kubernetes in Docker)
curl -Lo ./kind https://kind.sigs.k8s.io/dl/v0.20.0/kind-linux-amd64
chmod +x ./kind
sudo mv ./kind /usr/local/bin/kind
Create a Kubernetes cluster using kind
# Create cluster configuration
cat > kind-cluster.yaml << EOF
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
- role: control-plane
  kubeadmConfigPatches:
  - |
    kind: InitConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "ingress-ready=true"
  extraPortMappings:
  - containerPort: 80
    hostPort: 80
    protocol: TCP
  - containerPort: 443
    hostPort: 443
    protocol: TCP
  - containerPort: 30080
    hostPort: 30080
    protocol: TCP
EOF

# Create the cluster
kind create cluster --config kind-cluster.yaml --name awx-cluster
Deploy AWX Operator
# Set kubectl context
kubectl cluster-info --context kind-awx-cluster

# Install AWX Operator
kubectl apply -f https://raw.githubusercontent.com/ansible/awx-operator/devel/deploy/awx-operator.yaml

# Wait for operator to be ready
kubectl wait --for=condition=available --timeout=300s deployment/awx-operator-controller-manager -n awx-operator-system
Subtask 1.3: Deploy AWX Instance
Create AWX instance configuration
cat > awx-instance.yaml << EOF
apiVersion: awx.ansible.com/v1beta1
kind: AWX
metadata:
  name: awx-mesh-demo
  namespace: default
spec:
  service_type: NodePort
  nodeport_port: 30080
  admin_user: admin
  admin_password_secret: awx-admin-password
  postgres_configuration_secret: awx-postgres-configuration
  secret_key_secret: awx-secret-key
EOF
Create required secrets
# Create admin password secret
kubectl create secret generic awx-admin-password \
  --from-literal=password=admin123

# Create postgres configuration secret
kubectl create secret generic awx-postgres-configuration \
  --from-literal=host=awx-mesh-demo-postgres-13 \
  --from-literal=port=5432 \
  --from-literal=database=awx \
  --from-literal=username=awx \
  --from-literal=password=awxpass123 \
  --from-literal=type=managed

# Create secret key
kubectl create secret generic awx-secret-key \
  --from-literal=secret_key=$(openssl rand -base64 32)
Deploy AWX instance
kubectl apply -f awx-instance.yaml

# Monitor deployment progress
kubectl get pods -w
Wait for AWX to be ready
# Check AWX status
kubectl get awx awx-mesh-demo

# Wait for all pods to be running
kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=awx-mesh-demo --timeout=600s

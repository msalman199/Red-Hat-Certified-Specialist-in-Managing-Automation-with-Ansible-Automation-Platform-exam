Subtask 2.2: Install Execution Nodes
Now we'll set up execution nodes on our mesh nodes.

Connect to Mesh Node 1
# SSH to mesh-node-1 (use provided credentials)
ssh student@mesh-node-1
Install receptor (the mesh networking component)
# Install Python and pip
sudo dnf install -y python3 python3-pip

# Install receptor
pip3 install --user receptor[work]

# Add to PATH
echo 'export PATH=$PATH:~/.local/bin' >> ~/.bashrc
source ~/.bashrc
Create receptor configuration for Mesh Node 1
mkdir -p ~/receptor-config

cat > ~/receptor-config/receptor.conf << EOF
---
- node:
    id: mesh-node-1

- log-level: info

- control-service:
    service: control
    filename: /tmp/receptor-mesh-node-1.sock

- work-command:
    worktype: ansible-runner
    command: ansible-runner
    params: worker
    allowruntimeparams: true

- tcp-listener:
    port: 27199

- tcp-peer:
    address: control-node:27199
    redial: true
EOF
Start receptor service on Mesh Node 1
# Create systemd service file
sudo tee /etc/systemd/system/receptor.service << EOF
[Unit]
Description=Receptor
After=network.target

[Service]
Type=simple
User=student
WorkingDirectory=/home/student
ExecStart=/home/student/.local/bin/receptor -c /home/student/receptor-config/receptor.conf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

# Enable and start service
sudo systemctl daemon-reload
sudo systemctl enable receptor
sudo systemctl start receptor
sudo systemctl status receptor

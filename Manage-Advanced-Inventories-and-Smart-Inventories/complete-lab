Subtask 3.3: Create and Run Test Playbooks
Create a Simple Test Playbook

Navigate to Templates and create a new Job Template
Create a playbook to test smart inventory functionality:
---
- name: Test Smart Inventory Functionality
  hosts: all
  gather_facts: yes
  tasks:
    - name: Display host information
      debug:
        msg: |
          Hostname: {{ ansible_hostname }}
          OS Family: {{ ansible_os_family }}
          Memory: {{ ansible_memtotal_mb }}MB
          IP Address: {{ ansible_default_ipv4.address }}
          
    - name: Create inventory report file
      copy:
        content: |
          Host: {{ ansible_hostname }}
          OS: {{ ansible_distribution }} {{ ansible_distribution_version }}
          Memory: {{ ansible_memtotal_mb }}MB
          CPUs: {{ ansible_processor_vcpus }}
          IP: {{ ansible_default_ipv4.address }}
        dest: /tmp/inventory_report_{{ ansible_hostname }}.txt
      delegate_to: localhost

Task 1: Install Dependencies and Packages for Automation Controller
Subtask 1.1: Update System and Install Basic Dependencies
First, we need to ensure our system is up-to-date and install essential packages.

Step 1: Connect to your cloud machine and update the system

# Update package repositories
sudo dnf update -y

# Install EPEL repository (for CentOS/RHEL)
sudo dnf install -y epel-release

# Install basic development tools
sudo dnf groupinstall -y "Development Tools"
Step 2: Install Python and pip

# Install Python 3 and pip
sudo dnf install -y python3 python3-pip python3-devel

# Verify Python installation
python3 --version
pip3 --version
Step 3: Install Git and other essential tools

# Install Git and other utilities
sudo dnf install -y git curl wget vim nano

# Install system libraries needed for compilation
sudo dnf install -y gcc openssl-devel libffi-devel
Subtask 1.2: Install Docker and Docker Compose
Automation Controller (AWX) runs in containers, so we need Docker.

Step 1: Install Docker

# Install Docker
sudo dnf install -y docker

# Start and enable Docker service
sudo systemctl start docker
sudo systemctl enable docker

# Add current user to docker group
sudo usermod -aG docker $USER

# Apply group changes (logout and login, or use newgrp)
newgrp docker

# Verify Docker installation
docker --version
Step 2: Install Docker Compose

# Download Docker Compose
sudo curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose

# Make it executable
sudo chmod +x /usr/local/bin/docker-compose

# Create symbolic link
sudo ln -s /usr/local/bin/docker-compose /usr/bin/docker-compose

# Verify installation
docker-compose --version
Subtask 1.3: Install Node.js and npm
AWX requires Node.js for building the web interface.

Step 1: Install Node.js

# Install Node.js and npm
sudo dnf install -y nodejs npm

# Verify installation
node --version
npm --version
Task 2: Set up PostgreSQL and Nginx
Subtask 2.1: Install and Configure PostgreSQL
Step 1: Install PostgreSQL

# Install PostgreSQL server and client
sudo dnf install -y postgresql postgresql-server postgresql-contrib

# Initialize PostgreSQL database
sudo postgresql-setup --initdb

# Start and enable PostgreSQL service
sudo systemctl start postgresql
sudo systemctl enable postgresql
Step 2: Configure PostgreSQL

# Switch to postgres user
sudo -u postgres psql

# Create database and user for AWX (run these commands in PostgreSQL prompt)
CREATE DATABASE awx;
CREATE USER awx WITH ENCRYPTED PASSWORD 'awxpassword';
GRANT ALL PRIVILEGES ON DATABASE awx TO awx;
ALTER USER awx CREATEDB;
\q
Step 3: Configure PostgreSQL authentication

# Edit pg_hba.conf file
sudo vim /var/lib/pgsql/data/pg_hba.conf

# Add or modify the following line (change 'ident' to 'md5' for local connections)
# local   all             all                                     md5

# Restart PostgreSQL to apply changes
sudo systemctl restart postgresql
Step 4: Test PostgreSQL connection

# Test connection with AWX user
psql -h localhost -U awx -d awx -W
# Enter password: awxpassword
# If successful, you should see the PostgreSQL prompt
\q
Subtask 2.2: Install and Configure Nginx
Step 1: Install Nginx

# Install Nginx
sudo dnf install -y nginx

# Start and enable Nginx service
sudo systemctl start nginx
sudo systemctl enable nginx

# Check Nginx status
sudo systemctl status nginx
Step 2: Configure firewall for Nginx

# Allow HTTP and HTTPS traffic through firewall
sudo firewall-cmd --permanent --add-service=http
sudo firewall-cmd --permanent --add-service=https
sudo firewall-cmd --reload

# Verify firewall rules
sudo firewall-cmd --list-all
Step 3: Test Nginx installation

# Check if Nginx is running
curl http://localhost

# You should see the default Nginx welcome page
Task 3: Install and Configure Automation Controller
Subtask 3.1: Download and Prepare AWX
Step 1: Clone AWX repository

# Navigate to home directory
cd ~

# Clone the latest AWX repository
git clone https://github.com/ansible/awx.git

# Navigate to AWX directory
cd awx

# Check available tags/versions
git tag | tail -10

# Checkout the latest stable version (replace X.X.X with actual version)
git checkout tags/21.14.0
Step 2: Install AWX CLI and Ansible

# Install Ansible and AWX CLI
pip3 install --user ansible awxkit

# Add pip user bin to PATH
echo 'export PATH=$PATH:~/.local/bin' >> ~/.bashrc
source ~/.bashrc

# Verify installations
ansible --version
awx --version
Subtask 3.2: Configure AWX Installation
Step 1: Prepare AWX configuration

# Navigate to AWX installer directory
cd ~/awx/tools/docker-compose

# Copy the example environment file
cp .env.example .env

# Edit the environment file
vim .env
Step 2: Configure environment variables

Edit the .env file with the following configuration:

# AWX Configuration
COMPOSE_PROJECT_NAME=awx
AWX_ADMIN_USER=admin
AWX_ADMIN_PASSWORD=adminpassword

# Database Configuration
DATABASE_USER=awx
DATABASE_PASSWORD=awxpassword
DATABASE_NAME=awx
DATABASE_PORT=5432
DATABASE_HOST=postgresql

# Redis Configuration
REDIS_PASSWORD=redispassword

# AWX Configuration
SECRET_KEY=awxsecretkey123456789
BROADCAST_WEBSOCKET_SECRET=broadcastsecret123

# Web Configuration
AWX_HOST=localhost
AWX_PORT=80
Step 3: Modify Docker Compose configuration

# Edit the docker-compose.yml file
vim docker-compose.yml
Update the PostgreSQL service to use the existing database:

version: '3.8'
services:
  postgresql:
    image: postgres:13
    environment:
      POSTGRES_DB: awx
      POSTGRES_USER: awx
      POSTGRES_PASSWORD: awxpassword
    volumes:
      - postgresql_data:/var/lib/postgresql/data
    ports:
      - "5432:5432"

  redis:
    image: redis:7
    command: redis-server --requirepass redispassword
    volumes:
      - redis_data:/data

  awx_web:
    image: quay.io/ansible/awx:21.14.0
    depends_on:
      - postgresql
      - redis
    environment:
      - DATABASE_HOST=postgresql
      - DATABASE_PORT=5432
      - DATABASE_NAME=awx
      - DATABASE_USER=awx
      - DATABASE_PASSWORD=awxpassword
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=redispassword
      - SECRET_KEY=awxsecretkey123456789
    ports:
      - "8080:8052"
    volumes:
      - awx_projects:/var/lib/awx/projects
      - awx_job_status:/var/lib/awx/job_status

  awx_task:
    image: quay.io/ansible/awx:21.14.0
    depends_on:
      - postgresql
      - redis
    environment:
      - DATABASE_HOST=postgresql
      - DATABASE_PORT=5432
      - DATABASE_NAME=awx
      - DATABASE_USER=awx
      - DATABASE_PASSWORD=awxpassword
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=redispassword
      - SECRET_KEY=awxsecretkey123456789
    volumes:
      - awx_projects:/var/lib/awx/projects
      - awx_job_status:/var/lib/awx/job_status

volumes:
  postgresql_data:
  redis_data:
  awx_projects:
  awx_job_status:
Subtask 3.3: Deploy AWX with Docker Compose
Step 1: Start AWX services

# Navigate to the docker-compose directory
cd ~/awx/tools/docker-compose

# Start AWX services
docker-compose up -d

# Check if containers are running
docker-compose ps

# View logs to monitor startup
docker-compose logs -f
Step 2: Wait for AWX to initialize

# Monitor AWX web container logs
docker-compose logs -f awx_web

# Wait for message indicating AWX is ready (usually takes 5-10 minutes)
# Look for: "AWX is ready"
Step 3: Verify AWX installation

# Check all containers are running
docker ps

# Test AWX web interface accessibility
curl http://localhost:8080

# Check AWX API
curl http://localhost:8080/api/v2/ping/
Subtask 3.4: Configure Nginx Reverse Proxy
Step 1: Create Nginx configuration for AWX

# Create AWX configuration file
sudo vim /etc/nginx/conf.d/awx.conf
Add the following configuration:

upstream awx {
    server 127.0.0.1:8080;
}

server {
    listen 80;
    server_name localhost;

    location / {
        proxy_pass http://awx;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
Step 2: Test and reload Nginx configuration

# Test Nginx configuration
sudo nginx -t

# Reload Nginx configuration
sudo systemctl reload nginx

# Check Nginx status
sudo systemctl status nginx

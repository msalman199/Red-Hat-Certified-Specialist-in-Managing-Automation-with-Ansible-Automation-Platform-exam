Create the project directory and sample playbooks:

# Connect to your AWX server via SSH
sudo mkdir -p /var/lib/awx/projects/lab15
cd /var/lib/awx/projects/lab15

# Create a web server setup playbook
sudo tee web-server-setup.yml << 'EOF'
---
- name: Configure Web Server
  hosts: web_servers
  become: yes
  tasks:
    - name: Install Apache
      package:
        name: httpd
        state: present
      when: ansible_os_family == "RedHat"

    - name: Install Apache on Ubuntu
      package:
        name: apache2
        state: present
      when: ansible_os_family == "Debian"

    - name: Start and enable Apache
      service:
        name: "{{ 'httpd' if ansible_os_family == 'RedHat' else 'apache2' }}"
        state: started
        enabled: yes

    - name: Create index.html
      copy:
        content: |
          <html>
          <head><title>Lab 15 Web Server</title></head>
          <body>
            <h1>Web Server Configured Successfully</h1>
            <p>Managed by Ansible Job Template</p>
          </body>
          </html>
        dest: "{{ '/var/www/html/index.html' if ansible_os_family == 'RedHat' else '/var/www/html/index.html' }}"
        mode: '0644'
EOF

# Create a system maintenance playbook
sudo tee system-maintenance.yml << 'EOF'
---
- name: System Maintenance Tasks
  hosts: all
  become: yes
  tasks:
    - name: Update package cache
      package:
        update_cache: yes
      when: ansible_os_family in ["RedHat", "Debian"]

    - name: Check disk usage
      shell: df -h
      register: disk_usage

    - name: Display disk usage
      debug:
        var: disk_usage.stdout_lines

    - name: Check system uptime
      shell: uptime
      register: system_uptime

    - name: Display uptime
      debug:
        var: system_uptime.stdout

    - name: Clean temporary files
      file:
        path: /tmp/*
        state: absent
      ignore_errors: yes
EOF

# Create a user management playbook
sudo tee user-management.yml << 'EOF'
---
- name: User Management
  hosts: all
  become: yes
  vars:
    app_users:
      - username: webadmin
        groups: wheel
      - username: appuser
        groups: users
  tasks:
    - name: Create application users
      user:
        name: "{{ item.username }}"
        groups: "{{ item.groups }}"
        state: present
        create_home: yes
      loop: "{{ app_users }}"

    - name: Set up SSH directory for users
      file:
        path: "/home/{{ item.username }}/.ssh"
        state: directory
        owner: "{{ item.username }}"
        group: "{{ item.username }}"
        mode: '0700'
      loop: "{{ app_users }}"
EOF

# Set proper ownership
sudo chown -R awx:awx /var/lib/awx/projects/lab15
